# Copy this file to .env only when an optional integration needs credentials.
# Never commit .env. Replace angle-bracket placeholders locally.

# Optional official map APIs. The current static map does not require them.
AMAP_API_KEY=<YOUR_AMAP_API_KEY>
BAIDU_MAP_AK=<YOUR_BAIDU_MAP_AK>

# Optional GitHub CLI/API publishing. Prefer `gh auth login` instead of storing it.
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>

# Optional proxy. Leave empty when unused.
HTTPS_PROXY=<YOUR_HTTPS_PROXY_URL>

